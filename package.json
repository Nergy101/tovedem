{
  "name": "tovedem",
  "version": "1.0.7",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/set-version.mjs && ng serve",
    "start:devcontainer": "node scripts/set-version.mjs && ng serve --host 0.0.0.0",
    "build": "ng build",
    "build:prod": "node scripts/set-version.mjs && ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --no-watch --no-progress --browsers ChromeHeadless",
    "test:ui": "ng test --browsers Chrome",
    "test:pb": "node --test pb_hooks/__tests__/*.test.js",
    "secrets:install": "bash scripts/install-git-hooks.sh",
    "secrets:scan": "gitleaks detect --redact --config .gitleaks.toml",
    "secrets:scan:staged": "gitleaks protect --staged --redact --config .gitleaks.toml",
    "import:galerij": "node scripts/import-galerij.mjs",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.3.0",
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/language-service": "^22.3.0",
    "@angular/material": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/platform-browser-dynamic": "^22.3.0",
    "@angular/router": "^22.3.0",
    "apexcharts": "^8.9.1",
    "bootstrap": "^5.3.9",
    "canvas-confetti": "^1.9.4",
    "driver.js": "^1.14.0",
    "jquery": "^4.1.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "jszip": "^3.10.2",
    "luxon": "^3.7.2",
    "mdb-angular-ui-kit": "^11.0.0",
    "ng-apexcharts": "^3.2.0",
    "ng-recaptcha": "^13.2.1",
    "ngx-awesome-uploader": "^19.0.1",
    "ngx-material-timepicker": "^13.1.1",
    "ngx-quill": "^31.0.1",
    "ngx-toastr": "^20.0.5",
    "pocketbase": "^0.29.0",
    "quill": "^2.0.3",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@eslint/js": "^10.0.1",
    "@funboxteam/optimizt": "^5.0.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jasmine": "~7.0.0",
    "@types/jszip": "^3.4.1",
    "@types/luxon": "^3.7.6",
    "angular-eslint": "^22.8.0",
    "eslint": "^10.15.0",
    "jasmine-core": "~7.0.2",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "yauzl": "^3.4.0"
  }
}
